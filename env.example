# copy to .env and fill in (session pooler URI, password URL-encoded)
DATABASE_URL=postgresql://postgres.xxxx:YOUR_ENCODED_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
PORT=3000
# comma-separated frontend URLs (no trailing slash). localhost is always allowed
ALLOWED_ORIGINS=https://your-frontend.onrender.com
